# ── FRONTEND (public — safe to expose) ─────────────────────
# Your Google OAuth client ID (reuse the one from your old auth setup,
# just add hypersync.live + localhost to its Authorized JavaScript origins)
VITE_GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com

# ── SERVER ONLY (set these in Netlify → Environment variables,
#    NEVER in this file with real values, NEVER with VITE_ prefix) ──
# AIRTABLE_TOKEN=
# AIRTABLE_BASE_ID=
# GOOGLE_CLIENT_ID=          (same value as above, server verifies against it)
# SESSION_SECRET=            (any long random string — run: openssl rand -hex 32)
# PAYMONGO_SECRET=
